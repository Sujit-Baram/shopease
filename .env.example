# ShopEase API settings. Copy to /opt/shopease/config/shopease.env on the server.
# Never commit the real file: it holds passwords.

APP_VERSION=1.0.0

# Admin page token: change this to a long random value
ADMIN_TOKEN=change-me-to-a-long-random-value

# Database: sqlite (single file, Module 1-3) or mysql (MySQL / Amazon RDS, Module 4+)
DB_ENGINE=sqlite
SQLITE_PATH=/opt/shopease/data/shopease.db

# Only when DB_ENGINE=mysql
DB_HOST=
DB_PORT=3306
DB_NAME=shopease
DB_USER=shopease
DB_PASSWORD=

# Module 5 (SQS + SNS): leave empty until then
ORDER_QUEUE_URL=
ORDER_TOPIC_ARN=
AWS_REGION=ap-south-1
